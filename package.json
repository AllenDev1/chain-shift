{
  "name": "chain-shift",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A 6x6 chain-reaction puzzle: predict where everything stops.",
  "scripts": {
    "start": "node tools/serve.mjs 8080",
    "test": "node --test tests/*.test.mjs",
    "build": "node tools/build-www.mjs",
    "sync": "npm run build && cap sync",
    "ios": "npm run sync && cap open ios",
    "android": "npm run sync && cap open android",
    "store-assets": "node tools/store/make.mjs"
  },
  "dependencies": {
    "@capacitor-community/admob": "^8.3.0",
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0"
  }
}
