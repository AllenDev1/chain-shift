{
  "appId": "com.chainshift.game",
  "appName": "Chain Shift",
  "webDir": "www",
  "backgroundColor": "#f4efe6",
  "ios": {
    "contentInset": "never"
  },
  "plugins": {
    "SystemBars": {
      "insetsHandling": "native",
      "initialViewportFitValueHint": "cover",
      "style": "LIGHT"
    },
    "SplashScreen": {
      "launchShowDuration": 300,
      "launchFadeOutDuration": 200,
      "backgroundColor": "#0f1020",
      "showSpinner": false
    }
  }
}
